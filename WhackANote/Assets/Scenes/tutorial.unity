  steps:
  - customDialogueBox: {fileID: 0}
    customDialogueText: {fileID: 0}
    customInstructionText: {fileID: 0}
    stepName: Mole Tap Demo
    dialogueText: 'A mole has popped up!


      When you give it a whack, it will
      make a sound.'
    triggerType: 1
    stepUIContainer: {fileID: 857519460}
    pulseCue: {fileID: 817286018}
    instructionText: Tap the mole to begin
    targetMoleIndex: 0
  - customDialogueBox: {fileID: 1131889411}
    customDialogueText: {fileID: 1913476559}
    customInstructionText: {fileID: 327896623}
    stepName: Score Intro
    dialogueText: 'Hitting a mole adds to your score!


      Hitting moles at different
      time windows can give you different points.'
    triggerType: 0
    stepUIContainer: {fileID: 1399689469}
    pulseCue: {fileID: 0}
    instructionText: Tap anywhere to continue
    targetMoleIndex: 0
  - customDialogueBox: {fileID: 1274366871}
    customDialogueText: {fileID: 608366690}
    customInstructionText: {fileID: 1091176703}
    stepName: Multiplier Intro
    dialogueText: 'Keep your rhythm going to build up your score multiplier.


      Different
      score continuations will lead to better multipliers.'
    triggerType: 0
    stepUIContainer: {fileID: 1399689469}
    pulseCue: {fileID: 0}
    instructionText: Tap anywhere to continue
    targetMoleIndex: 0
  - customDialogueBox: {fileID: 311582090}
    customDialogueText: {fileID: 996188516}
    customInstructionText: {fileID: 1558910326}
    stepName: Miss Intro
    dialogueText: 'Try not to miss...


      If you miss a certain amount of times,
      you could end your round early you wont get any points at all.'
    triggerType: 0
    stepUIContainer: {fileID: 1399689469}
    pulseCue: {fileID: 0}
    instructionText: Tap anywhere to continue
    targetMoleIndex: 0
  - customDialogueBox: {fileID: 1393398384}
    customDialogueText: {fileID: 1292220455}
    customInstructionText: {fileID: 2141836043}
    stepName: Mini-Game Step
    dialogueText: 'Now let''s give a simple game a try - no multipliers, just focus
      on the beat!


      Tap the moles to play Twinkle Twinkle Little Star.


      Remember
      the tutorial steps to help you along!'
    triggerType: 0
    stepUIContainer: {fileID: 1399689469}
    pulseCue: {fileID: 0}
    instructionText: Tap to play your first track
    targetMoleIndex: 0
  - customDialogueBox: {fileID: 0}
    customDialogueText: {fileID: 0}
    customInstructionText: {fileID: 0}
    stepName: Mini-Game Step
    dialogueText: .
